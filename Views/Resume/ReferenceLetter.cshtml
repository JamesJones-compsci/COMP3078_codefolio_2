@{
    ViewBag.Title = "Reference Letter";
    Layout = "_Layout";
}

<!-- Banner -->
<div class="hero-banner text-center text-white">
    <img src="~/img/bernd-dittrich-PSB6bGW-r7k-unsplash.jpg"
         alt="Monitor setup"
         class="hero-image" asp-append-version="true" />


    <div class="hero-text">
        <h1 class="display-3 fw-bold">Reference Letter</h1>
    </div>
</div>

<div class="container mt-5 pt-4">
    <hr style="border-top: 4px solid #708090;" />
    <h2 class="text-center">Reference Letter</h2>
    <hr style="border-top: 4px solid #708090;" />

    <p>
        To whom it may concern,
    </p>

    <p>
        I am pleased to recommend James Jones, a dedicated and hardworking student
        in the Computer Programming and Analysis program...
    </p>

    <p>
        He has demonstrated strong skills in software development, teamwork,
        and problem-solving throughout his academic journey...
    </p>

    <p>
        I strongly recommend him for any opportunity in software development.
    </p>

    <p>
        Sincerely,<br />
        Professor Name
    </p>
</div>