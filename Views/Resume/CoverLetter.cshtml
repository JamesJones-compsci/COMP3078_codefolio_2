@{
    ViewBag.Title = "Cover Letter";
    Layout = "_Layout";
}

<!-- Banner -->
<div class="hero-banner text-center text-white">
    <img src="~/img/bernd-dittrich-PSB6bGW-r7k-unsplash.jpg"
         alt="Monitor setup"
         class="hero-image" asp-append-version="true" />

    <div class="hero-text">
        <h1 class="display-3 fw-bold">Cover Letter</h1>
    </div>
</div>

<div class="container mt-5 pt-4">
    <hr style="border-top: 4px solid #708090;" />
    <h2 class="text-center">Cover Letter</h2>
    <hr style="border-top: 4px solid #708090;" />

    <p class="mt-4">
        Dear Hiring Manager,
    </p>

    <p>
        I am a third-year Computer Programming and Analysis student with experience in full-stack development,
        object-oriented programming, and database design...
    </p>

    <p>
        My academic projects have allowed me to build scalable web applications using ASP.NET Core,
        implement RESTful APIs, and apply Agile methodologies...
    </p>

    <p>
        Thank you for your time and consideration.
    </p>

    <p>
        Sincerely,<br />
        James Jones
    </p>
</div>